{
  "name": "cr-time-pro",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
  "appId": "com.crtimepro.app",
  "productName": "C.R Time Pro",

  "win": {
    "target": "nsis",
    "icon": "favicon.ico"
  },

  "nsis": {
    "oneClick": false,
    "perMachine": false,

    "allowToChangeInstallationDirectory": true,

    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,

    "shortcutName": "C.R Time Pro",

    "runAfterFinish": true,

    "deleteAppDataOnUninstall": false
  }
},
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  }
}
